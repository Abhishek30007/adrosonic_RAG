# ========================================================
# Enterprise RAG Configuration Template (.env.example)
# Copy this file to .env and fill in your credentials
# ========================================================

# Groq API Configuration (Main generation key)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq RAGAS Evaluation Key (Dedicated key for LLM judge to prevent rate limiting)
GROQ_RAGAS_API_KEY=gsk_your_groq_ragas_api_key_here

GROQ_MODEL_NAME=openai/gpt-oss-20b

# Qdrant Cloud Cluster Configuration (Optional - falls back to local storage if omitted)
# QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# Embedding Thread Allocation (Optional)
# FAST_EMBED_THREADS=4
